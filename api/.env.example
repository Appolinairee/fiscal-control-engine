APP_NAME=Bank Files Harmonizer API
ENVIRONMENT=development
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000
RAS_CLASSIFICATION_RULES_PATH=/workspace/docs/reference/ras-classification-rules.csv
ACCOUNT_MAPPING_LEDGER_ACCOUNTS_PATH=/workspace/api/app/account_mapping/tests/fixtures/ledger_accounts.csv
ACCOUNT_MAPPING_PLAN_ACCOUNTS_PATH=/workspace/api/app/account_mapping/tests/fixtures/plan_accounts.csv
RAG_EMBEDDING_PROVIDER=deterministic
RAG_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
LLM_PROVIDER_CHAIN=internal:controlled-response
LLM_OPENAI_COMPATIBLE_API_KEY=
LLM_OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
LLM_DEFAULT_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1200
EXCEL_AGENT_ALLOWED_ROOT_PATH=/workspace/docs
AGENT_MAX_ANSWER_CHARACTERS=4000
AGENT_FILE_STORAGE_ROOT_PATH=/workspace/.local/agent-files
AGENT_FILE_TTL_SECONDS=86400
AGENT_FILE_MAX_UPLOAD_BYTES=20000000
